@page "/skills"

<PageTitle>Skills</PageTitle>

<div class="container py-4">

    <h1 class="text-center fw-bold text-danger mb-4">
        Skills
    </h1>

    <div class="row g-4">

        <!-- ==================== FRONTEND DEVELOPMENT ==================== -->
        <div class="col-12 col-lg-6">

            <h2 class="text-center mb-3 border-bottom pb-2">
                Frontend Development
            </h2>

            <div class="row g-3">

                <!-- HTML -->
                <div class="col-6 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <img src="skills/html.png"
                                 class="skill-icon mb-2"
                                 alt="HTML" />
                            <h6 class="text-black mb-0">HTML</h6>
                        </div>
                    </div>
                </div>

                <!-- CSS -->
                <div class="col-6 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <img src="skills/css.png"
                                 class="skill-icon mb-2"
                                 alt="CSS" />
                            <h6 class="text-black mb-0">CSS</h6>
                        </div>
                    </div>
                </div>

                <!-- Bootstrap -->
                <div class="col-6 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <img src="skills/bootstrap.png"
                                 class="skill-icon mb-2"
                                 alt="Bootstrap" />
                            <h6 class="text-black mb-0">Bootstrap</h6>
                        </div>
                    </div>
                </div>

                <!-- JavaScript -->
                <div class="col-6 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <img src="skills/javascript.png"
                                 class="skill-icon mb-2"
                                 alt="JavaScript" />
                            <h6 class="text-black mb-0">JavaScript</h6>
                        </div>
                    </div>
                </div>

                <!-- TypeScript -->
                <div class="col-6 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <img src="skills/typescript.png"
                                 class="skill-icon mb-2"
                                 alt="TypeScript" />
                            <h6 class="text-black mb-0">TypeScript</h6>
